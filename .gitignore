# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# oh-my-claudecode runtime state (see ~/.claude/CLAUDE.md) — everything under
# .omc/ is an ignored operational artifact except .omc/skills/**
/.omc/*
!/.omc/skills/
!/.omc/plans/
!/.omc/specs/

# typescript
*.tsbuildinfo
next-env.d.ts

# regenerable synthetic test fixtures (large PNGs) - keep ground-truth JSON + generator script
/scripts/fixtures/*.png

# geometric-gate real-photo test cases (docs/testing/geometric-gate-guide.md) -
# kept local-only by user decision (2026-08-30): 30+ real photos would add
# ~10-20MB permanently to repo history. Run scripts/geometric-gate.ts locally
# and share the report, not the raw photos.
/test-data/
